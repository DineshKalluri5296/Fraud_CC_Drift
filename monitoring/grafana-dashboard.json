{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [

    {
      "title": "Prediction Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "prediction_requests_total"
        }
      ]
    },

    {
      "title": "Prediction Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(request_latency_seconds_sum[1m]) / rate(request_latency_seconds_count[1m])"
        }
      ]
    },

    {
      "title": "Fraud Predictions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "fraud_predictions_total"
        }
      ]
    },

    {
      "title": "Non Fraud Predictions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nonfraud_predictions_total"
        }
      ]
    },

    {
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])"
        }
      ]
    },

    {
      "title": "Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes"
        }
      ]
    },

    {
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(prediction_requests_total[1m])"
        }
      ]
    },

    {
      "title": "API Availability",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"fraud-api\"}"
        }
      ]
    }

  ],

  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "fraud",
    "mlops"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "",
  "title": "Fraud Detection MLOps Dashboard",
  "version": 1
}